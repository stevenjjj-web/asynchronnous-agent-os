# State and Gateway
AGENT_OS_HOME=./data
PORT=3030
AGENT_GATEWAY_BIND=127.0.0.1
# Required for non-loopback access
AGENT_GATEWAY_TOKEN=

# Any OpenAI-compatible chat-completions endpoint
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL_ID=gpt-4.1-mini
AGENT_MODEL_TIMEOUT_MS=90000

# Async kernel
AGENT_CONCURRENCY=4
AGENT_TICK_MS=200
AGENT_LEASE_MS=30000
