# State and Gateway
AGENT_OS_HOME=./data
PORT=3030
AGENT_GATEWAY_BIND=127.0.0.1
# Required for every Gateway, including loopback. Generate with: openssl rand -hex 32
AGENT_GATEWAY_TOKEN=

# Any OpenAI-compatible chat-completions endpoint
AGENT_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL_ID=gpt-4.1-mini
AGENT_MODEL_TIMEOUT_MS=90000

# Optional signed memory portability (PEM or one-line base64 DER)
AGENT_MEMORY_PRIVATE_KEY=
AGENT_MEMORY_PUBLIC_KEY=
# Required for encrypted remote memory sync. Generate with: openssl rand -base64 32
AGENT_MEMORY_ENCRYPTION_KEY=
AGENT_MEMORY_PROVIDER_TOKEN=

# Async kernel
AGENT_CONCURRENCY=4
AGENT_TICK_MS=200
AGENT_LEASE_MS=30000

# Terminal experience
AGENT_OS_NO_ANIMATION=0
AGENT_OS_SIMPLE_UI=0
